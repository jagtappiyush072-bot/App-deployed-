    st.session_state.trust_bar = 100
if "chances_left" not in st.session_state:
    # User has 3 chances for fraud detection
    st.session_state.chances_left = 3
if "last_action_reason" not in st.session_state:
    st.session_state.last_action_reason = ""

# =====================================================================
# 3. FUNCTION TO UPDATE TRUST BAR BASED ON ACTIONS
# =====================================================================
def update_trust_bar(change: int):
    """
    Adjusts the trust bar value based on user actions.

    Args:
        change (int): Amount to change the trust bar by (positive or negative).
    """
    st.session_state.trust_bar = max(0, min(100, st.session_state.trust_bar + change))

